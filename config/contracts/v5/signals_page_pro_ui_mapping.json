{
  "version": "2.0",
  "generated_at": "2026-03-03",
  "page": "signals",
  "title": "Лента сигналов (PRO)",
  "description": "Операционный терминал для PRO трейдера: EdgeRank (динамический), режим рынка, план (target/stop), причины/риски, пресеты и фильтры.",
  "defaults": {
    "window": "30m",
    "sort": [
      {
        "field": "edgeRank100",
        "dir": "desc"
      },
      {
        "field": "conf_pct",
        "dir": "desc"
      },
      {
        "field": "ts",
        "dir": "desc"
      }
    ],
    "filters": {
      "only_pro_alerts": true,
      "edgeRank100_min": 55,
      "conf_min": 35,
      "profit_min": 8,
      "actions": [
        "BUY",
        "SELL",
        "WATCH"
      ],
      "market_regimes": [
        "RISK_ON",
        "MEAN_REVERT",
        "RISK_OFF",
        "PANIC"
      ]
    },
    "density": "compact",
    "autoRefresh": true,
    "realtime": true
  },
