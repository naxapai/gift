        "url": "/v1/signals"
      },
      "market": {
        "method": "GET",
        "url": "/v1/market/status?window=30m"
      }
    },
    "realtime": {
      "transport": "SSE",
      "endpoint": "/v1/stream/signals",
      "event": "signal.created"
