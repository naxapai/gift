        "type": "kv",
        "items": [
          {
            "k": "EdgeRaw",
            "path": "edgeRank_raw"
          },
          {
            "k": "EdgeRank100",
            "path": "edgeRank100"
          },
          {
            "k": "Профиль",
            "path": "edgeRank_profile"
          }
        ]
      }
    ]
