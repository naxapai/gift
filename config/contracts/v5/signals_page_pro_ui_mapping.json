  "filters": [
    {
      "id": "action",
      "ui": "Сигнал",
      "type": "multi",
      "options": [
        "BUY",
        "SELL",
        "WATCH",
        "SKIP"
      ],
      "default": [
        "BUY",
        "SELL",
        "WATCH"
      ]
    },
    {
      "id": "market_regime",
      "ui": "Режим рынка",
      "type": "multi",
      "options": [
        "RISK_ON",
        "MEAN_REVERT",
        "RISK_OFF",
        "PANIC"
      ],
      "default": [
        "RISK_ON",
        "MEAN_REVERT",
        "RISK_OFF",
        "PANIC"
      ]
    },
    {
      "id": "edgeRank100_min",
      "ui": "EdgeRank ≥",
      "type": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 55
    },
    {
      "id": "conf_min",
      "ui": "Conf ≥",
      "type": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 35
    },
    {
      "id": "profit_min",
      "ui": "Profit% ≥",
      "type": "slider",
      "min": 0,
      "max": 50,
      "step": 0.5,
      "default": 8
    },
    {
      "id": "liq_min",
      "ui": "Liquidity ≥",
      "type": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 35
    },
    {
      "id": "lp_max",
      "ui": "LP ≤",
      "type": "slider",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "default": 4.0
    },
    {
      "id": "ar_min",
      "ui": "AR ≥",
      "type": "slider",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "default": 0.9
    },
    {
      "id": "vv_min",
      "ui": "VV ≥",
      "type": "slider",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "default": 1.0
    },
    {
      "id": "search",
      "ui": "Поиск",
      "type": "text",
      "fields": [
        "collection",
        "model",
        "background",
        "pattern",
        "variant_id",
        "variant_label"
      ]
    },
    {
      "id": "only_pro_alerts",
      "ui": "Только PRO-алерты",
      "type": "toggle",
      "default": true,
      "expr": "edgeRank100>=55 && conf_pct>=35 && expected_profit_pct>=8"
    }
  ],
  "presets": [
    {
      "id": "pro_alerts",
      "ui": "PRO-алерты",
      "expr": "edgeRank100>=55 && conf_pct>=35 && expected_profit_pct>=8 && action in (BUY,SELL,WATCH)"
    },
    {
      "id": "top_buy",
      "ui": "Топ BUY",
      "expr": "action=='BUY' && edgeRank100>=65 && conf_pct>=40 && expected_profit_pct>=10"
    },
    {
      "id": "defense_sell",
      "ui": "Защита (SELL)",
      "expr": "action=='SELL' && conf_pct>=40 && (listing_pressure>=4 || absorption_30m<=0.8)"
    },
    {
      "id": "panic_hunt",
      "ui": "PANIC охота",
      "expr": "market_regime=='PANIC' && volume_velocity>=1.2 && edgeRank100>=55"
    }
  ]
}