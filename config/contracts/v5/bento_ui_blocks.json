  "generated_at": "2026-03-03",
  "ui_language": "ru",
  "layout_system": {
    "grid": {
      "columns": 12,
      "rowHeight": 88,
      "gap": 12,
      "breakpoints": {
        "xl": {
          "minWidth": 1280,
          "columns": 12
