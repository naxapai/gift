        "md": {
          "minWidth": 768,
          "columns": 8
        },
        "sm": {
          "minWidth": 480,
          "columns": 4
        }
      }
    },
    "card": {
      "radius": 18,
      "shadow": "soft",
      "padding": 16,
      "headerHeight": 40
    }
  },
  "realtime": {
    "transport": "SSE",
    "endpoints": {
      "signals_stream": "/v1/stream/signals",
      "metrics_stream": "/v1/stream/metrics",
      "market_stream": "/v1/stream/market"
    },
    "events": {
      "signal_created": "signal.created",
      "metrics_updated": "metrics.updated",
      "market_status": "market.status"
    },
    "dedupe": {
      "signal": {
        "key": "signal_id",
        "ttl_seconds": 600
      }
    }
  },
  "data_sources": {
    "http": {
      "market_status": {
        "method": "GET",
        "url": "/v1/market/status?window=30m"
      },
      "market_overview": {
        "method": "GET",
        "url": "/v1/market/overview?window=30m"
      },
      "variants_list": {
        "method": "GET",
        "url": "/v1/variants?sort=edgeRank&dir=desc&limit=100"
      },
      "variant_details": {
        "method": "GET",
        "url": "/v1/variants/{variant_id}?window=30m"
      },
      "signals_feed": {
        "method": "GET",
        "url": "/v1/signals?limit=200&sort=ts&dir=desc"
      }
    }
  },
